/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secreport",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-23",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Cron Triggers: 資料の自動取り込み（ポーリング、docs_jp/tasks.md P2-A参照）。
	 * UTC 03:00（JST 12:00）に1日1回、登録済みティッカー全件の最新10-Qを確認・取得する。
	 * SEC EDGARの提出頻度（四半期ごと）に対して十分な頻度であり、過度な負荷をかけない。
	 * スケジュールを変更する場合はこの値を編集して再デプロイすること（Cronの設定はこのファイルが正）。
	 */
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "secreport-db",
			"database_id": "5d7168f8-323e-4ea1-b1ab-64f431a91dc6",
			"remote": true
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "secreport-chunks",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "FILINGS_BUCKET",
			"bucket_name": "secreport-filings",
			"remote": true
		}
	],
	/**
	 * Workflows: EDGAR Fetcher〜索引化のWorkflow化（docs_jp/tasks.md P2-B参照）。
	 * 失敗時に最初からやり直す waitUntil ベースの暫定実装から、各ステップ単位で
	 * リトライ・再開できる Cloudflare Workflows に移行した。
	 */
	"workflows": [
		{
			"name": "ingest-filing-workflow",
			"binding": "INGEST_FILING_WORKFLOW",
			"class_name": "IngestFilingWorkflow"
		}
	]
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}